# =====================================================
# Korea Energy Dashboard — 환경변수 설정
# 이 파일을 복사해서 .env 로 저장한 뒤 값을 채우세요
# .env 파일은 절대 GitHub에 올리지 마세요 (.gitignore 확인)
# =====================================================

# 1. Notion Integration Token
NOTION_TOKEN=ntn_your_notion_token_here

# 2. 공공데이터포털 API 키 (data.go.kr)
DATA_GO_KR_KEY=your_data_go_kr_service_key_here

# 3. EIA API 키 (완전 무료) https://www.eia.gov/opendata/register.php
EIA_API_KEY=your_eia_api_key_here
